          }
        }
      ]
    },
    {
      "name": "Проверка обязательных и допустимых полей",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{ownerUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{ownerPassword}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/snippets/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "snippets",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"invalid-language\",\n  \"style\": \"invalid-style\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Ответ содержит ошибки полей\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.keys(\"code\", \"language\", \"style\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Создать сниппет",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{ownerUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{ownerPassword}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/snippets/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "snippets",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman — учебный сниппет\",\n  \"code\": \"print('hello')\",\n  \"linenos\": true,\n  \"language\": \"python\",\n  \"style\": \"friendly\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"snippetId\", \"__not_created__\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"API вернул ID и назначил владельца\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"snippetId\", String(data.id));",
              "    pm.expect(data.owner).to.eql(pm.variables.get(\"ownerUsername\"));",
              "    pm.expect(data.highlight).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Прочитать созданный сниппет",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/snippets/{{snippetId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "snippets",
            "{{snippetId}}",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Возвращается созданный сниппет\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(String(data.id)).to.eql(pm.collectionVariables.get(\"snippetId\"));",
              "    pm.expect(data.code).to.eql(\"print('hello')\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Список пользователей со ссылками",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Профиль владельца содержит ссылку на сниппет\", function () {",
              "    const users = pm.response.json();",
              "    const owner = users.find(user => user.username === pm.variables.get(\"ownerUsername\"));",
              "    pm.expect(owner).to.be.an(\"object\");",
              "    const id = pm.collectionVariables.get(\"snippetId\");",
              "    pm.expect(owner.snippets.some(url => url.endsWith(\"/snippets/\" + id + \"/\"))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "HTML-подсветка",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
